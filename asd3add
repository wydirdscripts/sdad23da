local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall
hookfunction(oldNamecall, newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and Cfg.SilentEnabled and W.CurrentSilentTarget and W.CurrentSilentTarget.Part then
        local targetHead = W.CurrentSilentTarget.Part
        
        -- 1. ESKİ MOTOR (FindPartOnRay / FindPartOnRayWithIgnoreList)
        if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
            local ray = args[1]
            if ray and typeof(ray) == "Ray" then
                local origin = ray.Origin
                local spoofedDirection = (targetHead.Position - origin).Unit * 1000
                args[1] = Ray.new(origin, spoofedDirection)
                
                t_ins(W.HitQ, {pos = targetHead.Position, headshot = (targetHead.Name == "Head"), time = tick()})
                
                return oldNamecall(self, unpack(args))
            end
        end
        
        -- 2. YENİ MOTOR (Raycast)
        if method == "Raycast" and self == workspace then
            local origin = args[1]
            local direction = args[2]
            
            if origin and direction and typeof(direction) == "Vector3" then
                local spoofedDirection = (targetHead.Position - origin).Unit * direction.Magnitude
                args[2] = spoofedDirection
                
                t_ins(W.HitQ, {pos = targetHead.Position, headshot = (targetHead.Name == "Head"), time = tick()})
                
                return oldNamecall(self, unpack(args))
            end
        end
    end

    return oldNamecall(self, ...)
end))
